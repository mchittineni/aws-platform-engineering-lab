region             = "eu-central-1"
vpc_cidr_block     = "10.25.0.0/16"
kubernetes_version = "1.34"

# Staging matches production: the API endpoint is private and reached through
# a VPN, a peered network, or an SSM port forward from a node.
endpoint_public_access  = false
api_public_access_cidrs = []

cluster_admin_role_arns = [
  "arn:aws:iam::000000000000:role/aws-platform-lab-staging-apply",
]

cluster_viewer_role_arns = [
  "arn:aws:iam::000000000000:role/Developer",
]

route53_hosted_zone_arns = [
  "arn:aws:route53:::hostedzone/CHANGE_ME",
]

# Empty means staging pulls the images production will run.
ecr_repositories = []

alert_emails = ["platform-oncall@example.com"]

# Turn on once the amazon-cloudwatch-observability add-on is installed.
enable_container_insights = false

owner = "platform-engineering"

# Permissions boundary every IAM role in this environment must carry. Take the
# value from the bootstrap output `ci_permissions_boundary_arn`. Required when
# this environment is applied by CI.
# permissions_boundary_arn = "arn:aws:iam::123456789012:policy/aws-platform-lab-ci-boundary"
