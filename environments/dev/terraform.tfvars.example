region             = "eu-central-1"
vpc_cidr_block     = "10.20.0.0/16"
kubernetes_version = "1.34"

# Restrict the public Kubernetes API endpoint to known egress addresses.
api_public_access_cidrs = ["203.0.113.10/32"]

# Roles that should get cluster admin, typically the CI deploy role and the
# platform team role.
cluster_admin_role_arns = [
  "arn:aws:iam::000000000000:role/aws-platform-lab-dev-apply",
]

ecr_repositories = ["demo-api", "demo-web"]

owner = "platform-engineering"

alert_emails = ["platform-oncall@example.com"]
